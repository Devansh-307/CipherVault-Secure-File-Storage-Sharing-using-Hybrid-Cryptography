# ==============================================================================
# CipherVault Environment Configuration (.env)
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
CIPHERVAULT_PORT=8000

# Set DEBUG=true for local development console OTP fallback when SMTP is unconfigured
DEBUG=false

# ------------------------------------------------------------------------------
# Real SMTP Email Configuration (e.g. Gmail)
# ------------------------------------------------------------------------------
# For Gmail:
#   1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
#   2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
#   3. Use smtp.gmail.com with port 587 (STARTTLS) or port 465 (SSL)
#   4. Set SMTP_USER to your full email address and SMTP_PASSWORD to the 16-char App Password (spaces optional)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
MAIL_FROM=your-email@gmail.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
